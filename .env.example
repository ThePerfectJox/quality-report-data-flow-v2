# Copy this file to .env and fill in your values. Never commit .env.
# Each device needs its own .env. See "Direct Ethernet setup on Windows" in README.md.

# ---------- Server device only ----------

# The IP the server listens on. Empty means all network interfaces (0.0.0.0).
SERVER_LISTEN_HOST=

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user

# Don't type these two by hand. To set them, run: python src/encrypt_db_password.py
# Anyone with both values can read the password, so keep .env private.
# If the database has no password, leave DB_PASSWORD_ENCRYPTED empty.
DB_ENCRYPTION_KEY=
DB_PASSWORD_ENCRYPTED=

# ---------- Client device only ----------

# The server's IP. A server IP given on the command line takes priority over this.
CLIENT_DEFAULT_SERVER_HOST=

# This device's own Ethernet IP, to connect from. Set it if the device also has Wi-Fi or a VPN.
# Empty lets Windows choose the network.

# ---------- Excel master data (client device) ----------
# The master data workbook is set in config/client-config.json (MASTER_DATA), not here.
# Edit it with: python src/run_config_editor.py

# A saved report JSON file. Only used by run_append_to_database.py when it's given no file;
# run_client.py appends the response directly. A relative path is taken from the project folder.
REPORT_JSON_PATH=test-response.json
