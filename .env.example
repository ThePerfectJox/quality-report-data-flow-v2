# Copy this file to .env and fill in your values. Never commit .env.
# Each device needs its own .env. See "Direct Ethernet setup on Windows" in README.md.

# ---------- Server device only ----------

# The IP the server listens on. Empty means all network interfaces (0.0.0.0).
SERVER_LISTEN_HOST=

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user

# Don't type these two by hand. To set them, run: python src/encrypt_db_password.py
# Anyone with both values can read the password, so keep .env private.
# If the database has no password, leave DB_PASSWORD_ENCRYPTED empty.
DB_ENCRYPTION_KEY=
DB_PASSWORD_ENCRYPTED=

# ---------- Client device only ----------

# The server's IP. A server IP given on the command line takes priority over this.
CLIENT_DEFAULT_SERVER_HOST=

# This device's own Ethernet IP, to connect from. Set it if the device also has Wi-Fi or a VPN.
# Empty lets Windows choose the network.
CLIENT_BIND_IP=

# ---------- Excel database (client device) ----------
# Used by: python src/append_data_to_excel_database.py
# Relative paths are resolved from the project folder, not from the terminal's current folder.

# The JSON response saved by run_client.py. Only used when running
# append_data_to_excel_database.py on its own; run_client.py appends the response directly.
REPORT_JSON_PATH=test-response.json

# The workbook that holds the database Excel Table. It must already exist.
# Archives are written to an "archived-<PLANT>" folder next to this workbook, such as archived-RK1.
EXCEL_DATABASE_PATH=excel/database.xlsx

# The worksheet and Excel Table to append to. Leave both empty to use the only table in the
# workbook. Set them when the workbook contains more than one Excel Table.
EXCEL_DATABASE_SHEET=
EXCEL_DATABASE_TABLE=
